# dependencies
node_modules/

# next.js
.next/
out/
next-env.d.ts

# typescript
*.tsbuildinfo

# runtime workspace (engine state, artifacts, tool scratch)
.aether-run/

# durable engine state must never be committed — it holds live tunnel URLs
engine-state.json

# env / secrets
.env
.env.*
!.env.example

# proof harness scratch
/tmp/
*.log

# os
.DS_Store

# Release signing material — never commit
keystore/
android/local.properties
android/.gradle/
android/build/
android/app/build/
android/app/release/

# APK binaries are reproducible via scripts/build-apk.sh; keep them out of git.
apk/*.apk
!apk/aether-2.6.0-release.apk
apk/*mapping.txt

# Engine credentials baked into the APK — never commit
android/credentials.properties
android/app/src/main/assets/aether-credentials.dat
__pycache__/
