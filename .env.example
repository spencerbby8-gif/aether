# Aether environment configuration — copy to .env (server) or export before
# running scripts. NEVER commit real values. .env is gitignored.
#
# Kaggle engine accounts (slot D is env-only by design; A/B/C usernames are
# public defaults, keys never are):
KAGGLE_USERNAME_A=fridaymoses
KAGGLE_KEY_A=
KAGGLE_USERNAME_B=spencercoldtr
KAGGLE_KEY_B=
KAGGLE_USERNAME_C=dyceelvk
KAGGLE_KEY_C=
KAGGLE_USERNAME_D=
KAGGLE_KEY_D=

# Engine control key — every engine POST is gated by the X-Engine-Key header.
ENGINE_OFF_KEY=

# ntfy beacon topic — engines announce stages and LIVE links here. Treat as a
# secret: anyone who knows the topic can watch your engines come online.
BEACON_TOPIC=

# Optional backup beacon (webhook.site URL) used to reap stale instances.
BEACON_BACKUP_URL=

# GitHub token for repo pushes (fine-grained, Contents: read/write).
GITHUB_TOKEN=
