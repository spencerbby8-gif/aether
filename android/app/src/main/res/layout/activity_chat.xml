<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/aether_bg">

    <!-- ============================================================== MAIN -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:background="@color/aether_bg">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingLeft="8dp" android:paddingRight="12dp"
            android:paddingTop="14dp" android:paddingBottom="10dp">

            <ImageView android:id="@+id/menu_btn" android:layout_width="38dp"
                android:layout_height="38dp" android:padding="9dp"
                android:src="@drawable/ic_menu" android:background="@drawable/bg_ghost_circle"
                android:contentDescription="@string/history" />

            <ImageView android:layout_width="26dp" android:layout_height="26dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_launcher_foreground"
                android:importantForAccessibility="no" />

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:layout_marginStart="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/app_name" android:textColor="@color/aether_fg"
                    android:textSize="@dimen/text_title" android:textStyle="bold" />
                <TextView android:id="@+id/header_sub" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/aether_muted"
                    android:textSize="@dimen/text_sub" android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView android:id="@+id/engine_chip" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:background="@drawable/bg_status_chip"
                android:textColor="@color/aether_muted" android:textSize="12sp"
                android:paddingLeft="12dp" android:paddingRight="12dp"
                android:paddingTop="6dp" android:paddingBottom="6dp"
                android:layout_marginEnd="6dp" />

            <TextView android:id="@+id/settings_btn" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="⚙"
                android:textColor="@color/aether_accent" android:textSize="20sp"
                android:padding="8dp" android:contentDescription="@string/settings" />
        </LinearLayout>

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView android:id="@+id/chat_scroll" android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:paddingLeft="14dp" android:paddingRight="14dp"
                android:clipToPadding="false" android:paddingBottom="8dp">
                <LinearLayout android:id="@+id/msg_list" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </ScrollView>
        </FrameLayout>

        <!-- ================================================== COMPOSER -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@color/aether_surface"
            android:padding="@dimen/composer_pad">

            <LinearLayout android:id="@+id/attach_row" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:visibility="gone" android:paddingBottom="8dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="bottom">

                <ImageView android:id="@+id/attach_btn" android:layout_width="@dimen/send_size"
                    android:layout_height="@dimen/send_size" android:padding="13dp"
                    android:src="@drawable/ic_attach" android:background="@drawable/bg_ghost_circle"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/attach" />

                <EditText android:id="@+id/input" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:hint="@string/composer_hint"
                    android:textColorHint="@color/aether_dim"
                    android:textColor="@color/aether_fg" android:textSize="@dimen/text_msg"
                    android:background="@drawable/bg_field" android:padding="12dp"
                    android:minLines="1" android:maxLines="5"
                    android:gravity="center_vertical|start"
                    android:inputType="textMultiLine|textCapSentences"
                    android:importantForAutofill="no" />

                <FrameLayout android:layout_width="@dimen/send_size"
                    android:layout_height="@dimen/send_size" android:layout_marginStart="8dp">
                    <ImageButton android:id="@+id/send_btn" android:layout_width="match_parent"
                        android:layout_height="match_parent" android:background="@drawable/bg_pill_accent"
                        android:src="@drawable/ic_send" android:contentDescription="Send"
                        android:scaleType="centerInside" />
                    <ImageButton android:id="@+id/stop_btn" android:layout_width="match_parent"
                        android:layout_height="match_parent" android:background="@drawable/bg_pill_ghost"
                        android:src="@drawable/ic_stop" android:contentDescription="@string/stop"
                        android:scaleType="centerInside" android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ===================================================== HISTORY DRAWER -->
    <LinearLayout android:layout_width="300dp" android:layout_height="match_parent"
        android:layout_gravity="start" android:orientation="vertical"
        android:background="@color/aether_surface" android:clickable="true"
        android:focusable="true">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingLeft="16dp" android:paddingRight="12dp"
            android:paddingTop="16dp" android:paddingBottom="10dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/history"
                android:textColor="@color/aether_fg" android:textSize="@dimen/text_title"
                android:textStyle="bold" />
            <ImageView android:id="@+id/new_chat_btn" android:layout_width="38dp"
                android:layout_height="38dp" android:padding="9dp"
                android:src="@drawable/ic_new_chat" android:background="@drawable/bg_pill_accent"
                android:contentDescription="@string/new_chat" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/hold_to_rename" android:textColor="@color/aether_dim"
            android:textSize="11sp" android:paddingLeft="16dp" android:paddingRight="16dp"
            android:paddingBottom="8dp" />

        <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:paddingLeft="10dp" android:paddingRight="10dp"
            android:clipToPadding="false">
            <LinearLayout android:id="@+id/session_list" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
        </ScrollView>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/history_local" android:textColor="@color/aether_dim"
            android:textSize="11sp" android:padding="16dp" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
