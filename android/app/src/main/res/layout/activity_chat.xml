<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@color/aether_bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:background="@color/aether_bg">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="12dp" android:paddingEnd="12dp"
            android:paddingTop="14dp" android:paddingBottom="9dp">
            <ImageView android:id="@+id/menu_btn" android:layout_width="48dp"
                android:layout_height="48dp" android:padding="10dp" android:src="@drawable/ic_menu"
                android:background="@drawable/bg_ghost_circle" android:contentDescription="Open recent chats" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="13dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Aether" android:textColor="@color/aether_fg" android:textSize="19sp"
                    android:textStyle="bold" android:letterSpacing="0.02" />
                <TextView android:id="@+id/header_sub" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Your private workspace"
                    android:textColor="@color/aether_muted" android:textSize="11sp"
                    android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
            <TextView android:id="@+id/engine_chip" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="@color/aether_muted"
                android:textSize="11sp" android:padding="6dp" android:maxLines="1" />
            <ImageView android:id="@+id/workspace_btn" android:layout_width="48dp"
                android:layout_height="48dp" android:padding="10dp" android:src="@drawable/ic_workspace"
                android:background="@drawable/bg_ghost_circle" android:contentDescription="Open workspace" />
        </LinearLayout>

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <ScrollView android:id="@+id/chat_scroll" android:layout_width="match_parent"
                android:layout_height="match_parent" android:fillViewport="true"
                android:paddingStart="18dp" android:paddingEnd="18dp"
                android:clipToPadding="false" android:paddingBottom="12dp">
                <LinearLayout android:id="@+id/msg_list" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </ScrollView>

            <LinearLayout android:id="@+id/welcome_panel" android:layout_width="match_parent"
                android:layout_height="match_parent" android:orientation="vertical"
                android:gravity="center" android:paddingStart="24dp" android:paddingEnd="24dp"
                android:paddingBottom="28dp" android:background="@drawable/bg_welcome">
                <ImageView android:layout_width="58dp" android:layout_height="58dp"
                    android:src="@drawable/ic_launcher_foreground" android:alpha="0.94"
                    android:importantForAccessibility="no" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" android:gravity="center"
                    android:text="welcome to aether,\nwhat are we doing today?"
                    android:textColor="@color/aether_fg" android:textSize="30sp"
                    android:textStyle="bold" android:lineSpacingExtra="3dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:gravity="center"
                    android:text="Ask, explore, create, or just talk."
                    android:textColor="@color/aether_muted" android:textSize="14sp" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="24dp" android:orientation="horizontal" android:gravity="center">
                    <TextView android:id="@+id/suggest_research" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="Explore" android:textSize="12sp"
                        android:textColor="@color/aether_fg" android:background="@drawable/bg_pill_ghost"
                        android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="10dp"
                        android:paddingBottom="10dp" />
                    <TextView android:id="@+id/suggest_create" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Create"
                        android:textSize="12sp" android:textColor="@color/aether_fg"
                        android:background="@drawable/bg_pill_ghost" android:paddingStart="14dp"
                        android:paddingEnd="14dp" android:paddingTop="10dp" android:paddingBottom="10dp" />
                    <TextView android:id="@+id/suggest_discuss" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Discuss"
                        android:textSize="12sp" android:textColor="@color/aether_fg"
                        android:background="@drawable/bg_pill_ghost" android:paddingStart="14dp"
                        android:paddingEnd="14dp" android:paddingTop="10dp" android:paddingBottom="10dp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp"
            android:paddingTop="4dp" android:paddingBottom="12dp">
            <LinearLayout android:id="@+id/attach_row" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:visibility="gone" android:paddingBottom="8dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_composer"
                android:paddingStart="12dp" android:paddingEnd="12dp"
                android:paddingTop="10dp" android:paddingBottom="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <LinearLayout android:id="@+id/model_selector" android:layout_width="0dp"
                        android:layout_height="48dp" android:layout_weight="1" android:orientation="horizontal"
                        android:gravity="center_vertical" android:clickable="true" android:focusable="true"
                        android:contentDescription="Choose model">
                        <ImageView android:layout_width="23dp" android:layout_height="23dp"
                            android:src="@drawable/ic_launcher_foreground" android:importantForAccessibility="no" />
                        <TextView android:id="@+id/model_name" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:layout_marginStart="7dp" android:textColor="@color/aether_accent"
                            android:textSize="11sp" android:textStyle="bold" android:maxLines="1"
                            android:ellipsize="end" />
                        <ImageView android:layout_width="17dp" android:layout_height="17dp"
                            android:src="@drawable/ic_chevron" android:rotation="90" android:alpha="0.7"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="34dp"
                        android:orientation="horizontal" android:background="@drawable/bg_segment_track"
                        android:padding="3dp">
                        <TextView android:id="@+id/mode_agent" android:layout_width="wrap_content"
                            android:layout_height="match_parent" android:gravity="center" android:text="Agent"
                            android:textSize="11sp" android:textStyle="bold" android:paddingStart="11dp"
                            android:paddingEnd="11dp" android:contentDescription="Use agent mode" />
                        <TextView android:id="@+id/mode_discuss" android:layout_width="wrap_content"
                            android:layout_height="match_parent" android:gravity="center" android:text="Discuss"
                            android:textSize="11sp" android:textStyle="bold" android:paddingStart="11dp"
                            android:paddingEnd="11dp" android:contentDescription="Use discussion mode" />
                    </LinearLayout>
                </LinearLayout>

                <EditText android:id="@+id/input" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="74dp" android:maxHeight="180dp"
                    android:hint="Message Aether…" android:textColorHint="@color/aether_dim"
                    android:textColor="@color/aether_fg" android:textSize="16sp" android:background="@null"
                    android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="12dp"
                    android:paddingBottom="8dp" android:minLines="3" android:maxLines="8"
                    android:gravity="top|start" android:inputType="textMultiLine|textCapSentences"
                    android:importantForAutofill="no" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:id="@+id/attach_btn" android:layout_width="48dp"
                        android:layout_height="48dp" android:padding="10dp" android:src="@drawable/ic_add"
                        android:background="@drawable/bg_ghost_circle" android:contentDescription="Add attachments, connectors or MCP" />
                    <TextView android:id="@+id/composer_mode_note" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="10dp" android:textColor="@color/aether_dim"
                        android:textSize="11sp" android:maxLines="2" />
                    <FrameLayout android:layout_width="48dp" android:layout_height="48dp">
                        <ImageButton android:id="@+id/send_btn" android:layout_width="match_parent"
                            android:layout_height="match_parent" android:background="@drawable/bg_pill_accent"
                            android:src="@drawable/ic_send" android:contentDescription="Send" android:scaleType="centerInside" />
                        <ImageButton android:id="@+id/stop_btn" android:layout_width="match_parent"
                            android:layout_height="match_parent" android:background="@drawable/bg_pill_ghost"
                            android:src="@drawable/ic_stop" android:contentDescription="@string/stop"
                            android:scaleType="centerInside" android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="300dp" android:layout_height="match_parent"
        android:layout_gravity="start" android:orientation="vertical"
        android:background="@color/aether_surface" android:clickable="true" android:focusable="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="18dp" android:paddingEnd="14dp" android:paddingTop="20dp" android:paddingBottom="12dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Workspace" android:textColor="@color/aether_fg" android:textSize="24sp"
                    android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Your recent conversations" android:textColor="@color/aether_muted"
                    android:textSize="11sp" />
            </LinearLayout>
            <ImageView android:id="@+id/new_chat_btn" android:layout_width="42dp"
                android:layout_height="42dp" android:padding="10dp" android:src="@drawable/ic_new_chat"
                android:background="@drawable/bg_pill_accent" android:contentDescription="@string/new_chat" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="RECENT CHATS" android:textColor="@color/aether_dim" android:textSize="11sp"
            android:letterSpacing="0.1" android:paddingStart="18dp" android:paddingBottom="10dp" />
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:paddingStart="10dp" android:paddingEnd="10dp"
            android:clipToPadding="false">
            <LinearLayout android:id="@+id/session_list" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
        </ScrollView>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Hold a chat to rename, share or delete. Local until you back up."
            android:textColor="@color/aether_dim" android:textSize="11sp" android:paddingStart="18dp"
            android:paddingEnd="18dp" android:paddingTop="10dp" android:paddingBottom="8dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="10dp"
            android:paddingBottom="14dp">
            <LinearLayout android:id="@+id/account_btn" android:layout_width="match_parent"
                android:layout_height="52dp" android:gravity="center_vertical" android:paddingStart="12dp"
                android:paddingEnd="12dp" android:background="@drawable/bg_settings_row">
                <TextView android:layout_width="32dp" android:layout_height="32dp" android:text="A"
                    android:gravity="center" android:textStyle="bold" android:textColor="@color/aether_fg"
                    android:background="@drawable/bg_ghost_circle" />
                <TextView android:id="@+id/account_label" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="11dp" android:text="Sign in or create account"
                    android:textColor="@color/aether_fg" android:textSize="13sp" android:maxLines="1"
                    android:ellipsize="end" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›"
                    android:textColor="@color/aether_dim" android:textSize="20sp" />
            </LinearLayout>
            <TextView android:id="@+id/drawer_connectors_btn" android:layout_width="match_parent"
                android:layout_height="50dp" android:text="Connectors &amp; MCP" android:gravity="center_vertical"
                android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="@color/aether_muted"
                android:textSize="13sp" />
            <TextView android:id="@+id/drawer_settings_btn" android:layout_width="match_parent"
                android:layout_height="50dp" android:text="Settings" android:gravity="center_vertical"
                android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="@color/aether_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
