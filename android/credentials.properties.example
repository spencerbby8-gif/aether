# Copy to android/credentials.properties (gitignored) and fill in, then run
# scripts/bake-credentials.sh before building.
#
# WARNING: these values end up inside the APK, obfuscated but recoverable by
# anyone who unpacks it. That is an accepted trade-off for a private build.
# If the APK ever leaves your phone, revoke all four Kaggle keys and rotate
# ENGINE_OFF_KEY.

engineA.user=your-first-kaggle-username
engineA.key=KGAT_xxxxxxxxxxxxxxxxxxxx
engineB.user=your-second-kaggle-username
engineB.key=KGAT_xxxxxxxxxxxxxxxxxxxx
engineC.user=your-third-kaggle-username
engineC.key=KGAT_xxxxxxxxxxxxxxxxxxxx
engineD.user=your-fourth-kaggle-username
engineD.key=KGAT_xxxxxxxxxxxxxxxxxxxx

kernelSlug=qwen-3-8-27b-uncensored-chat

# The key every engine's POST routes are gated on.
offKey=

# ntfy topic the engines announce their tunnel URLs to.
beaconTopic=

# HMAC secret for signed announcements. Leave blank if announcements are unsigned.
beaconSecret=
